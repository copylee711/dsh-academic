{
  "name": "@copylee/dsh-academic",
  "version": "0.4.0",
  "description": "DeepSeek Harness 学术插件：连接本机 Zotero；多源论文检索（arXiv、OpenAlex、Crossref、PubMed 等）、阅读开放获取全文、获取引文、核验参考文献；内置文献综述、论文精读、写作润色、模拟审稿等学术技能。",
  "type": "module",
  "author": "copylee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copylee711/dsh-academic.git"
  },
  "bugs": {
    "url": "https://github.com/copylee711/dsh-academic/issues"
  },
  "homepage": "https://github.com/copylee711/dsh-academic#readme",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.mjs",
    "lib/types/**/*.d.ts",
    "skills/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc && tsdown",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run",
    "smoke:zotero": "node scripts/zotero-smoke.mjs",
    "smoke:search": "node scripts/search-smoke.mjs",
    "skills:import": "node scripts/import-nature-skills.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "academic",
    "research",
    "zotero",
    "citation",
    "bibtex",
    "literature",
    "paper",
    "arxiv",
    "pubmed",
    "openalex",
    "crossref",
    "skills",
    "literature-review",
    "academic-writing",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "fast-xml-parser": "^5.2.5",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unpdf": "^1.4.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  }
}
